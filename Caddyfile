# APP_DOMAIN comes from .env, e.g. plex.example.com.
# Caddy gets a certificate for it automatically and redirects http to https.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000
}
