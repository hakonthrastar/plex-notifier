# Copy to .env.local for development, or to .env next to docker-compose.yml on the server.
# Never commit real values.

# Plex account token (app.plex.tv → browser console: localStorage.myPlexAccessToken)
PLEX_TOKEN=
# Optional: which shared server to use, if more than one is shared with you
PLEX_SERVER_NAME=

# Resend API key (starts with re_, sending access only) and the verified sender
RESEND_API_KEY=
EMAIL_FROM=Plex Notifier <plex@notify.example.com>

# Better Auth: a random secret (openssl rand -base64 32) and the app's public URL.
# On the server this is the https:// address your reverse proxy serves; sign-in links,
# digest emails and the login origin check all use it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server only: host port the app's plain-HTTP listener is published on (default 3000)
APP_PORT=

# Optional: minutes between checks for new episodes (default 15)
CHECK_INTERVAL_MINUTES=
# Optional: SQLite location (default file:data/app.db)
DATABASE_URL=
